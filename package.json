{
  "name": "khanware-practice-assistant",
  "version": "0.3.0",
  "private": true,
  "description": "Khanware Practice Assistant (Chrome MV3)",
  "scripts": {
    "check": "for f in src/*.js src/*/*.js scripts/*.js; do node --check $f || exit 1; done",
